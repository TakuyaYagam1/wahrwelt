+void Wallpaper::syncLiveWallpapers() {
+  if (m_liveController == nullptr || m_config == nullptr || m_wayland == nullptr || m_syncingExternalOutputs) {
+    return;
+  }
+
+  m_syncingExternalOutputs = true;
+  std::vector<noctalia::wallpaper::LiveWallpaperTarget> targets;
+  std::unordered_set<std::string> usableConnectors;
+  for (const auto& output : m_wayland->outputs()) {
+    if (!output.done || output.connectorName.empty() || !output.hasUsableGeometry()) {
+      continue;
+    }
+    if (const auto* overrideConfig = wallpaper::findWallpaperMonitorOverride(m_config->config().wallpaper, output);
+        overrideConfig != nullptr && overrideConfig->enabled && !*overrideConfig->enabled) {
+      continue;
+    }
+    usableConnectors.insert(output.connectorName);
+    const std::string path = m_config->getWallpaperPath(output.connectorName);
+    if (!path.empty() && noctalia::wallpaper::WallpaperMedia::isLivePath(path)
+        && noctalia::wallpaper::WallpaperMedia::isPlayable(path)) {
+      targets.push_back({.path = path, .connector = output.connectorName});
+    }
+  }
+
+  const std::vector<std::string> active = m_liveController->apply(targets);
+  const std::unordered_set<std::string> activeSet(active.begin(), active.end());
+  for (const auto& connector : usableConnectors) {
+    const bool shouldBeExternal = activeSet.contains(connector);
+    const bool isExternal = m_externallyManagedOutputs.contains(connector);
+    if (shouldBeExternal == isExternal) {
+      continue;
+    }
+    if (shouldBeExternal) {
+      m_externallyManagedOutputs.insert(connector);
+    } else {
+      m_externallyManagedOutputs.erase(connector);
+    }
+  }
+  for (auto it = m_externallyManagedOutputs.begin(); it != m_externallyManagedOutputs.end();) {
+    if (!usableConnectors.contains(*it)) {
+      it = m_externallyManagedOutputs.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  m_syncingExternalOutputs = false;
+}
