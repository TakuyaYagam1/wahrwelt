+#include "shell/wallpaper/wallpaper_media.h"
+
+#include "core/process/process.h"
+
+#include <webp/demux.h>
+#include <webp/decode.h>
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <limits>
+#include <optional>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace {
+
+  [[nodiscard]] std::string lowerExtension(const std::filesystem::path& path) {
+    std::string ext = path.extension().string();
+    std::ranges::transform(ext, ext.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return ext;
+  }
+
+  [[nodiscard]] bool hasExtension(std::string_view ext) {
+    static constexpr std::array<std::string_view, 5> live = {".mp4", ".webm", ".mkv", ".mov", ".avi"};
+    return std::ranges::contains(live, ext);
+  }
+
+  [[nodiscard]] bool animatedWebp(const std::filesystem::path& path) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+      return false;
+    }
+    stream.seekg(0, std::ios::end);
+    const auto size = stream.tellg();
+    if (size <= 0) {
+      return false;
+    }
+    const auto byteCount = static_cast<std::uintmax_t>(size);
+    if (byteCount > std::numeric_limits<std::size_t>::max()) {
+      return false;
+    }
+    stream.seekg(0, std::ios::beg);
+    std::vector<std::uint8_t> bytes(static_cast<std::size_t>(byteCount));
+    stream.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    if (!stream || bytes.empty()) {
+      return false;
+    }
+    WebPData data{bytes.data(), bytes.size()};
+    WebPDemuxer* demux = WebPDemux(&data);
+    if (demux == nullptr) {
+      return false;
+    }
+    const bool animated = WebPDemuxGetI(demux, WEBP_FF_FRAME_COUNT) > 1;
+    WebPDemuxDelete(demux);
+    return animated;
+  }
+
+  [[nodiscard]] std::uint64_t cacheKey(const std::filesystem::path& path) {
+    std::error_code ec;
+    const auto size = std::filesystem::file_size(path, ec);
+    const auto stamp = std::filesystem::last_write_time(path, ec).time_since_epoch().count();
+    std::string input = path.string() + ":" + std::to_string(size) + ":" + std::to_string(stamp);
+    std::uint64_t hash = 14695981039346656037ULL;
+    for (unsigned char c : input) {
+      hash ^= c;
+      hash *= 1099511628211ULL;
+    }
+    return hash;
+  }
+
+  [[nodiscard]] std::filesystem::path cacheDirectory() {
+    if (const char* cache = std::getenv("XDG_CACHE_HOME"); cache != nullptr && *cache != '\0') {
+      return std::filesystem::path(cache) / "noctalia" / "wallpaper-frames";
+    }
+    if (const char* home = std::getenv("HOME"); home != nullptr && *home != '\0') {
+      return std::filesystem::path(home) / ".cache" / "noctalia" / "wallpaper-frames";
+    }
+    return {};
+  }
+
+} // namespace
+
+namespace noctalia::wallpaper {
+
+MediaKind WallpaperMedia::kindForPath(const std::filesystem::path& path) {
+  const std::string ext = lowerExtension(path);
+  if (ext == ".gif" || hasExtension(ext) || (ext == ".webp" && animatedWebp(path))) {
+    return MediaKind::Live;
+  }
+  return MediaKind::Static;
+}
+
+bool WallpaperMedia::isLivePath(const std::filesystem::path& path) { return kindForPath(path) == MediaKind::Live; }
+
+bool WallpaperMedia::isSupportedPath(const std::filesystem::path& path) {
+  const std::string ext = lowerExtension(path);
+  static constexpr std::array<std::string_view, 9> supported = {
+      ".jpg", ".jpeg", ".png", ".webp", ".jxl", ".bmp", ".gif", ".mp4", ".webm",
+  };
+  static constexpr std::array<std::string_view, 3> extra = {".mkv", ".mov", ".avi"};
+  return std::ranges::contains(supported, ext) || std::ranges::contains(extra, ext);
+}
+
+bool WallpaperMedia::isPlayable(const std::filesystem::path& path) {
+  if (!isLivePath(path)) {
+    return true;
+  }
+  if (lowerExtension(path) == ".webp") {
+    return true;
+  }
+  const auto result = process::runSync(
+      {"ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=codec_type", "-of",
+       "default=noprint_wrappers=1:nokey=1", path.string()}
+  );
+  return static_cast<bool>(result);
+}
+
+std::filesystem::path WallpaperMedia::ensureThumbnail(const std::filesystem::path& path) {
+  if (!isLivePath(path) || path.empty()) {
+    return path;
+  }
+  const auto dir = cacheDirectory();
+  if (dir.empty()) {
+    return path;
+  }
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  if (ec) {
+    return path;
+  }
+  const auto output = dir / (std::to_string(cacheKey(path)) + ".png");
+  if (std::filesystem::is_regular_file(output, ec) && !ec) {
+    return output;
+  }
+  const auto result = process::runSync(
+      {"ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y", "-i", path.string(), "-vf",
+       "scale=512:512:force_original_aspect_ratio=decrease,pad=512:512:(ow-iw)/2:(oh-ih)/2", "-frames:v", "1",
+       "-f", "image2", output.string()}
+  );
+  if (!result || !std::filesystem::is_regular_file(output, ec) || ec) {
+    std::filesystem::remove(output, ec);
+    return path;
+  }
+  return output;
+}
+
