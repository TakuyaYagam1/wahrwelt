+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+namespace noctalia::lockscreen {
+
+class VideoFrameAssembler {
+public:
+  explicit VideoFrameAssembler(std::size_t frameBytes);
+
+  void append(std::string_view chunk);
+  [[nodiscard]] std::optional<std::vector<std::uint8_t>> takeLatest();
+  [[nodiscard]] std::size_t bufferedBytes() const noexcept;
+
+private:
+  std::size_t m_frameBytes;
+  std::vector<std::uint8_t> m_pending;
+  std::optional<std::vector<std::uint8_t>> m_latest;
+};
+
+class LockscreenVideoPlayer {
+public:
+  static constexpr int kWidth = 1280;
+  static constexpr int kHeight = 720;
+  static constexpr std::size_t kFrameBytes = static_cast<std::size_t>(kWidth) * static_cast<std::size_t>(kHeight) * 4U;
+
+  LockscreenVideoPlayer();
+  ~LockscreenVideoPlayer();
+
+  LockscreenVideoPlayer(const LockscreenVideoPlayer&) = delete;
+  LockscreenVideoPlayer& operator=(const LockscreenVideoPlayer&) = delete;
+
+  [[nodiscard]] bool start(std::string_view path);
+  void stop() noexcept;
+  [[nodiscard]] bool isRunning() const;
+  [[nodiscard]] std::optional<std::vector<std::uint8_t>> takeLatestFrame();
+
+private:
+  struct SharedState;
+  std::shared_ptr<SharedState> m_state;
+};
+
+} // namespace noctalia::lockscreen
