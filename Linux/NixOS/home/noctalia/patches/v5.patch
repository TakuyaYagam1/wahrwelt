+#pragma once
+
+#include <functional>
+#include <memory>
+#include <unordered_map>
+#include <string>
+#include <string_view>
+#include <cstdint>
+#include <vector>
+
+namespace noctalia::wallpaper {
+
+class ProcessHandle {
+public:
+  virtual ~ProcessHandle() = default;
+  virtual bool isRunning() const = 0;
+  virtual void terminate() = 0;
+};
+
+using ProcessLauncher = std::function<std::unique_ptr<ProcessHandle>(const std::vector<std::string>&)>;
+
+struct LiveWallpaperTarget {
+  std::string path;
+  std::string connector;
+};
+
+class LiveWallpaperController {
+public:
+  explicit LiveWallpaperController(ProcessLauncher launcher = {});
+  ~LiveWallpaperController();
+
+  LiveWallpaperController(const LiveWallpaperController&) = delete;
+  LiveWallpaperController& operator=(const LiveWallpaperController&) = delete;
+
+  // Advance the bounded retry clock and report whether reconciliation is needed.
+  [[nodiscard]] bool onSecondTick();
+
+  // Apply one persisted path to a set of output connectors. A failed launch is
+  // omitted from the returned list, allowing the native wallpaper to recover.
+  [[nodiscard]] std::vector<std::string>
+  apply(const std::string& path, const std::vector<std::string>& connectors);
+  [[nodiscard]] std::vector<std::string> apply(const std::vector<LiveWallpaperTarget>& targets);
+  void clear();
+
+  [[nodiscard]] static std::vector<std::string>
+  commandFor(std::string_view path, std::string_view connector);
+
+private:
+  void recordFailure(const std::string& connector, const std::string& path);
+
+  struct Child {
+    std::string path;
+    std::unique_ptr<ProcessHandle> process;
+  };
+
+  struct Retry {
+    std::string path;
+    std::uint8_t failures = 0;
+    std::uint64_t nextTick = 0;
+    std::uint8_t healthyTicks = 0;
+    std::uint64_t lastFailureTick = 0;
+  };
+
+  ProcessLauncher m_launcher;
+  std::unordered_map<std::string, Child> m_children;
+  std::unordered_map<std::string, Retry> m_retries;
+  std::uint64_t m_tick = 0;
+};
+
+} // namespace noctalia::wallpaper
