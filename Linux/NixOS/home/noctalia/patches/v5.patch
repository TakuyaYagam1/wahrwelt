+void LockSurface::ensureVideoPlayback() {
+  if (m_videoFrameTimer.active()) {
+    return;
+  }
+  if (!m_videoPlayer.start(m_wallpaperPath)) {
+    return;
+  }
+  m_videoFrameTimer.startRepeating(std::chrono::milliseconds(33), [this] { consumeVideoFrame(); });
+}
+
+void LockSurface::consumeVideoFrame() {
+  auto* renderer = renderContext();
+  if (renderer == nullptr || width() == 0 || height() == 0) {
+    return;
+  }
+
+  const auto frame = m_videoPlayer.takeLatestFrame();
+  if (!frame.has_value()) {
+    if (!m_videoPlayer.isRunning()) {
+      m_videoFrameTimer.stop();
+    }
+    return;
+  }
+  if (!renderer->makeCurrent(renderTarget())) {
+    return;
+  }
+
+  auto& textures = renderer->textureManager();
+  if (m_videoTexture.id == 0) {
+    m_videoTexture = textures.loadFromRgba(
+        frame->data(), noctalia::lockscreen::LockscreenVideoPlayer::kWidth,
+        noctalia::lockscreen::LockscreenVideoPlayer::kHeight, false
+    );
+  } else if (!textures.updateSubImage(
+                 m_videoTexture, frame->data(), 0, 0, noctalia::lockscreen::LockscreenVideoPlayer::kWidth,
+                 noctalia::lockscreen::LockscreenVideoPlayer::kHeight, TextureDataFormat::Rgba
+             )) {
+    textures.unload(m_videoTexture);
+    m_videoTexture = textures.loadFromRgba(
+        frame->data(), noctalia::lockscreen::LockscreenVideoPlayer::kWidth,
+        noctalia::lockscreen::LockscreenVideoPlayer::kHeight, false
+    );
+  }
+  if (m_videoTexture.id == 0) {
+    return;
+  }
+
+  m_wallpaperLease.reset();
+  m_pendingWallpaperLease.reset();
+  m_shownWallpaperPath.clear();
+  m_pendingWallpaperPath.clear();
+  m_wallpaper->setTextures(
+      m_videoTexture.id, {}, static_cast<float>(m_videoTexture.width), static_cast<float>(m_videoTexture.height), 0.0F,
+      0.0F
+  );
+  m_wallpaper->setTransition(WallpaperTransition::Fade, 0.0F, TransitionParams{});
+  m_wallpaper->setFillMode(m_wallpaperFillMode);
+  m_wallpaper->setFillColor(m_wallpaperFillColor);
+  m_wallpaperDirty = false;
+  requestRedraw();
+}
+
+void LockSurface::stopVideoPlayback() {
+  m_videoFrameTimer.stop();
+  m_videoPlayer.stop();
+  // Keep the last frame until the next wallpaper has finished loading.
+}
+
+void LockSurface::releaseVideoTexture() {
+  if (m_videoTexture.id == 0) {
+    return;
+  }
+  if (renderContext() != nullptr) {
+    renderContext()->backend().makeCurrentNoSurface();
+    renderContext()->textureManager().unload(m_videoTexture);
+  }
+  m_videoTexture = {};
+}
