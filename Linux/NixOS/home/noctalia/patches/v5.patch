+#pragma once
+
+#include <functional>
+#include <memory>
+#include <unordered_map>
+#include <string>
+#include <string_view>
+#include <cstdint>
+#include <vector>
+
+namespace noctalia::wallpaper {
+
+class ProcessHandle {
+public:
+  virtual ~ProcessHandle() = default;
+  virtual bool isRunning() const = 0;
+  virtual void terminate() = 0;
+};
+
+using ProcessLauncher = std::function<std::unique_ptr<ProcessHandle>(const std::vector<std::string>&)>;
+
+struct LiveWallpaperTarget {
+  std::string path;
+  std::string connector;
+};
+
+class LiveWallpaperController {
+public:
+  explicit LiveWallpaperController(ProcessLauncher launcher = {});
+  ~LiveWallpaperController();
+
+  LiveWallpaperController(const LiveWallpaperController&) = delete;
+  LiveWallpaperController& operator=(const LiveWallpaperController&) = delete;
+
+  // Advance the bounded retry clock and report whether reconciliation is needed.
+  [[nodiscard]] bool onSecondTick();
+
+  // Apply one persisted path to a set of output connectors. A failed launch is
+  // omitted from the returned list, allowing the native wallpaper to recover.
+  [[nodiscard]] std::vector<std::string>
+  apply(const std::string& path, const std::vector<std::string>& connectors);
+  [[nodiscard]] std::vector<std::string> apply(const std::vector<LiveWallpaperTarget>& targets);
+  void clear();
+
+  [[nodiscard]] static std::vector<std::string>
+  commandFor(std::string_view path, std::string_view connector);
+
+private:
+  void recordFailure(const std::string& connector, const std::string& path);
+
+  struct Child {
+    std::string path;
+    std::unique_ptr<ProcessHandle> process;
+  };
+
+  struct Retry {
+    std::string path;
+    std::uint8_t failures = 0;
+    std::uint64_t nextTick = 0;
+    std::uint8_t healthyTicks = 0;
+    std::uint64_t lastFailureTick = 0;
+  };
+
+  ProcessLauncher m_launcher;
+  std::unordered_map<std::string, Child> m_children;
+  std::unordered_map<std::string, Retry> m_retries;
+  std::uint64_t m_tick = 0;
+};
+
+} // namespace noctalia::wallpaper
--- /dev/null
+++ b/src/shell/wallpaper/live_wallpaper_controller.cpp
@@ -0,0 +1,207 @@
+#include "shell/wallpaper/live_wallpaper_controller.h"
+
+#include "core/process/process.h"
+
+#include <cerrno>
+#include <csignal>
+#include <unordered_map>
+#include <unordered_set>
+#include <optional>
+#include <utility>
+
+namespace noctalia::wallpaper {
+
+namespace {
+
+  constexpr std::uint8_t kMaxLaunchFailures = 3;
+  constexpr std::uint8_t kHealthyTicksToReset = 3;
+
+  class TrackedProcess final : public ProcessHandle {
+  public:
+    explicit TrackedProcess(int pid) : m_pid(pid) {}
+    ~TrackedProcess() override { terminate(); }
+    [[nodiscard]] bool isRunning() const override {
+      if (!m_pid.has_value()) {
+        return false;
+      }
+      if (::kill(*m_pid, 0) == 0) {
+        return true;
+      }
+      return errno == EPERM;
+    }
+    void terminate() override {
+      if (m_pid.has_value()) {
+        process::terminateTracked(*m_pid);
+        m_pid.reset();
+      }
+    }
+
+  private:
+    std::optional<int> m_pid;
+  };
+
+  [[nodiscard]] std::unique_ptr<ProcessHandle> launchTracked(const std::vector<std::string>& command) {
+    if (!process::commandExists("mpvpaper")) {
+      return nullptr;
+    }
+    const auto pid = process::launchDetachedTracked(command);
+    if (!pid.has_value()) {
+      return nullptr;
+    }
+    return std::make_unique<TrackedProcess>(*pid);
+  }
+
+} // namespace
+
+LiveWallpaperController::LiveWallpaperController(ProcessLauncher launcher)
+    : m_launcher(launcher ? std::move(launcher) : ProcessLauncher(launchTracked)) {}
+
+void LiveWallpaperController::recordFailure(const std::string& connector, const std::string& path) {
+  auto retry = m_retries.find(connector);
+  const bool fresh = retry == m_retries.end() || retry->second.path != path;
+  if (fresh) {
+    if (retry != m_retries.end()) {
+      m_retries.erase(retry);
+    }
+    retry = m_retries.emplace(connector, Retry{.path = path}).first;
+  }
+  auto& state = retry->second;
+  state.healthyTicks = 0;
+  if (!fresh && state.lastFailureTick == m_tick) {
+    return;
+  }
+  if (state.failures < kMaxLaunchFailures) {
+    ++state.failures;
+    state.nextTick = m_tick + (std::uint64_t{1} << (state.failures - 1));
+  }
+  state.lastFailureTick = m_tick;
+}
+
+bool LiveWallpaperController::onSecondTick() {
+  ++m_tick;
+  bool reconcile = false;
+  for (auto& [connector, child] : m_children) {
+    if (!child.process || !child.process->isRunning()) {
+      recordFailure(connector, child.path);
+      reconcile = true;
+      continue;
+    }
+    auto retry = m_retries.find(connector);
+    if (retry != m_retries.end() &&
+        ++retry->second.healthyTicks >= kHealthyTicksToReset) {
+      m_retries.erase(retry);
+    }
+  }
+  if (reconcile) {
+    return true;
+  }
+  for (const auto& [connector, retry] : m_retries) {
+    if (m_children.contains(connector)) {
+      continue;
+    }
+    if (retry.failures < kMaxLaunchFailures && retry.nextTick <= m_tick) {
+      return true;
+    }
+  }
+  return false;
+}
+
+LiveWallpaperController::~LiveWallpaperController() { clear(); }
+
+std::vector<std::string> LiveWallpaperController::commandFor(std::string_view path, std::string_view connector) {
+  return {"mpvpaper", "-o", "--no-audio --loop-file=inf --panscan=1", std::string(connector), std::string(path)};
+}
+
+std::vector<std::string>
+LiveWallpaperController::apply(const std::string& path, const std::vector<std::string>& connectors) {
+  std::vector<LiveWallpaperTarget> targets;
+  targets.reserve(connectors.size());
+  for (const auto& connector : connectors) {
+    targets.push_back({.path = path, .connector = connector});
+  }
+  return apply(targets);
+}
+
+std::vector<std::string> LiveWallpaperController::apply(const std::vector<LiveWallpaperTarget>& targets) {
+  std::unordered_map<std::string, std::string> desired;
+  std::vector<std::string> orderedConnectors;
+  for (const auto& target : targets) {
+    if (!target.connector.empty()) {
+      if (!desired.contains(target.connector)) {
+        orderedConnectors.push_back(target.connector);
+      }
+      desired.insert_or_assign(target.connector, target.path);
+    }
+  }
+  for (auto it = m_children.begin(); it != m_children.end();) {
+    const auto desiredPath = desired.find(it->first);
+    if (desiredPath == desired.end() || desiredPath->second != it->second.path) {
+      if (it->second.process) {
+        it->second.process->terminate();
+      }
+      m_retries.erase(it->first);
+      it = m_children.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  for (auto it = m_retries.begin(); it != m_retries.end();) {
+    const auto desiredPath = desired.find(it->first);
+    if (desiredPath == desired.end() || desiredPath->second != it->second.path) {
+      it = m_retries.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  for (auto it = m_children.begin(); it != m_children.end();) {
+    if (!it->second.process || !it->second.process->isRunning()) {
+      recordFailure(it->first, it->second.path);
+      it = m_children.erase(it);
+    } else {
+      ++it;
+    }
+  }
+
+  std::vector<std::string> active;
+  active.reserve(desired.size());
+  for (const auto& connector : orderedConnectors) {
+    const auto& path = desired.at(connector);
+    auto existing = m_children.find(connector);
+    if (existing != m_children.end()) {
+      active.push_back(connector);
+      continue;
+    }
+    auto retry = m_retries.find(connector);
+    if (retry != m_retries.end()) {
+      if (retry->second.path != path) {
+        m_retries.erase(retry);
+        retry = m_retries.end();
+      } else if (retry->second.failures >= kMaxLaunchFailures || retry->second.nextTick > m_tick) {
+        continue;
+      }
+    }
+    auto child = m_launcher(commandFor(path, connector));
+    if (!child) {
+      recordFailure(connector, path);
+      continue;
+    }
+    if (retry != m_retries.end()) {
+      retry->second.healthyTicks = 0;
+    }
+    m_children.emplace(connector, Child{path, std::move(child)});
+    active.push_back(connector);
+  }
+  return active;
+}
+
+void LiveWallpaperController::clear() {
+  for (auto& [_, child] : m_children) {
+    if (child.process) {
+      child.process->terminate();
+    }
+  }
+  m_children.clear();
+  m_retries.clear();
+}
+
