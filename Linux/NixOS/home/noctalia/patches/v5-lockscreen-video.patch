+#include "shell/lockscreen/lockscreen_video_player.h"
+
+#include "core/process/process.h"
+
+#include <atomic>
+#include <mutex>
+#include <utility>
+
+namespace noctalia::lockscreen {
+
+VideoFrameAssembler::VideoFrameAssembler(std::size_t frameBytes) : m_frameBytes(frameBytes == 0 ? 1 : frameBytes) {}
+
+void VideoFrameAssembler::append(std::string_view chunk) {
+  if (chunk.empty()) {
+    return;
+  }
+
+  m_pending.insert(
+      m_pending.end(), reinterpret_cast<const std::uint8_t*>(chunk.data()),
+      reinterpret_cast<const std::uint8_t*>(chunk.data() + chunk.size())
+  );
+  const std::size_t completeFrames = m_pending.size() / m_frameBytes;
+  if (completeFrames == 0) {
+    return;
+  }
+
+  const std::size_t latestOffset = (completeFrames - 1) * m_frameBytes;
+  m_latest = std::vector<std::uint8_t>(
+      m_pending.begin() + static_cast<std::ptrdiff_t>(latestOffset),
+      m_pending.begin() + static_cast<std::ptrdiff_t>(latestOffset + m_frameBytes)
+  );
+  const std::size_t remainderOffset = completeFrames * m_frameBytes;
+  std::vector<std::uint8_t> remainder(
+      m_pending.begin() + static_cast<std::ptrdiff_t>(remainderOffset), m_pending.end()
+  );
+  m_pending.swap(remainder);
+}
+
+std::optional<std::vector<std::uint8_t>> VideoFrameAssembler::takeLatest() {
+  if (!m_latest.has_value()) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<std::uint8_t>> result = std::move(m_latest);
+  m_latest.reset();
+  return result;
+}
+
+std::size_t VideoFrameAssembler::bufferedBytes() const noexcept { return m_pending.size(); }
+
+struct LockscreenVideoPlayer::SharedState {
+  explicit SharedState(std::size_t frameBytes)
+      : assembler(frameBytes), cancel(std::make_shared<std::atomic<bool>>(false)) {}
+
+  mutable std::mutex mutex;
+  VideoFrameAssembler assembler;
+  std::shared_ptr<std::atomic<bool>> cancel;
+  bool running = false;
+};
+
+LockscreenVideoPlayer::LockscreenVideoPlayer() = default;
+
+LockscreenVideoPlayer::~LockscreenVideoPlayer() { stop(); }
+
+bool LockscreenVideoPlayer::start(std::string_view path) {
+  stop();
+  if (path.empty() || !process::commandExists("ffmpeg")) {
+    return false;
+  }
+
+  auto state = std::make_shared<SharedState>(kFrameBytes);
+  state->running = true;
+  std::vector<std::string> args{
+      "ffmpeg",
+      "-hide_banner",
+      "-loglevel",
+      "error",
+      "-nostdin",
+      "-re",
+      "-stream_loop",
+      "-1",
+      "-i",
+      std::string(path),
+      "-vf",
+      "fps=30,scale=1280:720:force_original_aspect_ratio=increase,crop=1280:720,format=rgba",
+      "-f",
+      "rawvideo",
+      "-pix_fmt",
+      "rgba",
+      "pipe:1",
+  };
+
+  process::RunCallbacks callbacks;
+  callbacks.stdOut = [state](std::string_view chunk) {
+    std::lock_guard lock(state->mutex);
+    if (!state->cancel->load(std::memory_order_relaxed)) {
+      state->assembler.append(chunk);
+    }
+  };
+  callbacks.stdErr = [](std::string_view) {};
+  callbacks.onExit = [state](process::RunResult) {
+    std::lock_guard lock(state->mutex);
+    state->running = false;
+  };
+
+  process::RunOptions options;
+  options.maxOutputBytes = 0;
+  options.cancel = state->cancel;
+  m_state = state;
+  if (!process::runAsync(args, std::move(callbacks), options)) {
+    state->cancel->store(true, std::memory_order_relaxed);
+    m_state.reset();
+    std::lock_guard lock(state->mutex);
+    state->running = false;
+    return false;
+  }
+  return true;
+}
+
+void LockscreenVideoPlayer::stop() noexcept {
+  auto state = std::exchange(m_state, std::shared_ptr<SharedState>{});
+  if (state != nullptr) {
+    state->cancel->store(true, std::memory_order_relaxed);
+  }
+}
+
+bool LockscreenVideoPlayer::isRunning() const {
+  const auto state = m_state;
+  if (state == nullptr) {
+    return false;
+  }
+  std::lock_guard lock(state->mutex);
+  return state->running && !state->cancel->load(std::memory_order_relaxed);
+}
+
+std::optional<std::vector<std::uint8_t>> LockscreenVideoPlayer::takeLatestFrame() {
+  const auto state = m_state;
+  if (state == nullptr) {
+    return std::nullopt;
+  }
+  std::lock_guard lock(state->mutex);
+  return state->assembler.takeLatest();
+}
+
