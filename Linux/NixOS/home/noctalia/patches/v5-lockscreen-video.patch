+++ b/tests/lockscreen_video_player_test.cpp
@@ -0,0 +1,99 @@
+#include "core/process/process.h"
+#include "shell/lockscreen/lockscreen_video_player.h"
+
+#include <array>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <string_view>
+#include <thread>
+#include <unordered_set>
+#include <vector>
+
+namespace {
+
+void expectFrame(const std::optional<std::vector<std::uint8_t>>& frame, std::string_view expected) {
+  assert(frame.has_value());
+  const std::vector<std::uint8_t> expectedBytes(expected.begin(), expected.end());
+  assert(*frame == expectedBytes);
+}
+
+void writePpm(const std::filesystem::path& path, const std::array<std::uint8_t, 3>& color) {
+  std::ofstream output(path, std::ios::binary);
+  assert(output);
+  output << "P6\n8 8\n255\n";
+  for (int pixel = 0; pixel < 64; ++pixel) {
+    output.write(reinterpret_cast<const char*>(color.data()), static_cast<std::streamsize>(color.size()));
+  }
+  assert(output.good());
+}
+
+std::uint64_t frameHash(const std::vector<std::uint8_t>& frame) {
+  std::uint64_t hash = 1469598103934665603ULL;
+  for (const std::uint8_t byte : frame) {
+    hash ^= byte;
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
+
+void expectDecodedFramesChange() {
+  const auto fixtureDir = std::filesystem::temp_directory_path() / "noctalia-lockscreen-video-test";
+  std::filesystem::remove_all(fixtureDir);
+  std::filesystem::create_directories(fixtureDir);
+  writePpm(fixtureDir / "frame-1.ppm", {255, 0, 0});
+  writePpm(fixtureDir / "frame-2.ppm", {0, 0, 255});
+
+  const auto fixturePath = fixtureDir / "fixture.mp4";
+  const process::RunResult encoded = process::runSync(
+      {
+          "ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y", "-framerate", "10", "-i",
+          (fixtureDir / "frame-%d.ppm").string(), "-frames:v", "2", "-c:v", "mpeg4", "-q:v", "2",
+          fixturePath.string(),
+      }
+  );
+  assert(static_cast<bool>(encoded));
+
+  noctalia::lockscreen::LockscreenVideoPlayer player;
+  assert(player.start(fixturePath.string()));
+  std::unordered_set<std::uint64_t> hashes;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (std::chrono::steady_clock::now() < deadline && hashes.size() < 2) {
+    if (auto frame = player.takeLatestFrame(); frame.has_value()) {
+      assert(frame->size() == noctalia::lockscreen::LockscreenVideoPlayer::kFrameBytes);
+      hashes.insert(frameHash(*frame));
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+  }
+  player.stop();
+  std::filesystem::remove_all(fixtureDir);
+  assert(hashes.size() >= 2);
+}
+
+} // namespace
+
+int main() {
+  noctalia::lockscreen::VideoFrameAssembler assembler(4);
+
+  assembler.append("ab");
+  assert(!assembler.takeLatest().has_value());
+
+  assembler.append("cd");
+  expectFrame(assembler.takeLatest(), "abcd");
+
+  assembler.append("ef");
+  assert(!assembler.takeLatest().has_value());
+  assembler.append("ghij");
+  expectFrame(assembler.takeLatest(), "efgh");
+  assert(assembler.bufferedBytes() == 2);
+
+  assembler.append("aa3333");
+  expectFrame(assembler.takeLatest(), "3333");
+  assert(assembler.bufferedBytes() == 0);
+
+  expectDecodedFramesChange();
+  return 0;
+}
